<!-- Announcement bar -->
<div class="announcement-bar">
  FREE SHIPPING ON ORDERS OVER $50 &nbsp;&middot;&nbsp; <span>USE CODE NUTRI10 FOR 10% OFF YOUR FIRST ORDER</span>
</div>

<header id="site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-18">

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="flex items-center gap-2.5 flex-shrink-0">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_max_width }}"
            height="auto"
            class="h-8 w-auto object-contain"
            loading="eager">
        {%- else -%}
          <div class="flex items-center gap-2 group">
            <div class="w-8 h-8 rounded-lg bg-green-500 flex items-center justify-center shadow-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15v-4H7l5-8v4h4l-5 8z" fill="black"/>
              </svg>
            </div>
            <span class="header-logo font-black text-lg tracking-tight text-white">
              Nutri<span class="text-green-400">Glen</span>
            </span>
          </div>
        {%- endif -%}
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-8">
        <a href="/#product"     class="nav-link">Shop</a>
        <a href="/#benefits"    class="nav-link">Benefits</a>
        <a href="/#how-it-works" class="nav-link">The Science</a>
        <a href="/#reviews"     class="nav-link">Reviews</a>
        <a href="/#faq"         class="nav-link">FAQ</a>
        <a href="/pages/about"  class="nav-link">About</a>
      </nav>

      <!-- Right icons -->
      <div class="flex items-center gap-4">
        <!-- Cart -->
        <button id="cart-drawer-btn" aria-label="Open cart" class="cart-icon relative p-1.5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18"/>
            <line x1="16" y1="10" x2="16" y2="10"/>
            <path d="M8 10a4 4 0 008 0"/>
          </svg>
          <span class="cart-badge" data-cart-count></span>
        </button>

        <!-- Shop Now CTA (desktop) -->
        <a href="/#product"
           class="hidden lg:inline-flex items-center gap-2 bg-white text-black font-bold text-sm px-5 py-2.5 rounded-md hover:bg-gray-100 transition-colors">
          Shop Now
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <!-- Hamburger (mobile) -->
        <button id="mobile-menu-btn" class="hamburger-btn lg:hidden p-2 rounded-md" aria-label="Toggle menu">
          <svg id="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="menu-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
            <path d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-zinc-800 py-4">
      <nav class="flex flex-col gap-1">
        <a href="/#product"      class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">Shop</a>
        <a href="/#benefits"     class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">Benefits</a>
        <a href="/#how-it-works" class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">The Science</a>
        <a href="/#reviews"      class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">Reviews</a>
        <a href="/#faq"          class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">FAQ</a>
        <a href="/pages/about"   class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">About</a>
        <a href="/pages/contact" class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">Contact</a>
        <a href="{{ routes.cart_url }}" class="text-zinc-400 hover:text-white font-semibold text-sm uppercase tracking-widest px-2 py-3 rounded-md hover:bg-zinc-900 transition-colors">Cart</a>
        <a href="/#product" class="mt-3 bg-white text-black font-bold text-sm px-5 py-3 rounded-md text-center hover:bg-gray-100 transition-colors">Shop Now</a>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
