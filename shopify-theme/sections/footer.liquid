<footer style="background:#001A4D" class="text-blue-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-10 mb-12">

      <!-- Brand -->
      <div class="col-span-2 lg:col-span-1">
        <a href="{{ routes.root_url }}" class="flex items-center gap-2 mb-5">
          <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background:#003087">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15v-4H7l5-8v4h4l-5 8z" fill="white"/>
            </svg>
          </div>
          <span class="font-bold text-lg text-white tracking-tight">Nutri<span style="color:#E07820">Glen</span></span>
        </a>
        <p class="text-sm text-blue-300 leading-relaxed mb-6">
          Premium supplements formulated with science-backed ingredients for real, measurable results.
        </p>
        <!-- Social -->
        <div class="flex gap-3">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" aria-label="Instagram"
               class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
               style="background:rgba(255,255,255,.08)"
               onmouseover="this.style.background='#E07820'" onmouseout="this.style.background='rgba(255,255,255,.08)'">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="white" stroke="none"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" aria-label="Facebook"
               class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
               style="background:rgba(255,255,255,.08)"
               onmouseover="this.style.background='#E07820'" onmouseout="this.style.background='rgba(255,255,255,.08)'">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok"
               class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
               style="background:rgba(255,255,255,.08)"
               onmouseover="this.style.background='#E07820'" onmouseout="this.style.background='rgba(255,255,255,.08)'">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="white">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9a8.16 8.16 0 004.77 1.53V7.1a4.85 4.85 0 01-1-.41z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Product links -->
      <div>
        <div class="text-white font-semibold text-xs uppercase tracking-widest mb-5">Product</div>
        <ul class="space-y-3 text-sm">
          <li><a href="#product"      class="text-blue-300 hover:text-white transition-colors">Vitamin K2 + D3</a></li>
          <li><a href="#product"      class="text-blue-300 hover:text-white transition-colors">Ingredients</a></li>
          <li><a href="#product"      class="text-blue-300 hover:text-white transition-colors">Supplement Facts</a></li>
          <li><a href="#how-it-works" class="text-blue-300 hover:text-white transition-colors">How to Use</a></li>
        </ul>
      </div>

      <!-- Support links -->
      <div>
        <div class="text-white font-semibold text-xs uppercase tracking-widest mb-5">Support</div>
        <ul class="space-y-3 text-sm">
          <li><a href="#faq"                    class="text-blue-300 hover:text-white transition-colors">FAQ</a></li>
          <li><a href="/pages/contact"           class="text-blue-300 hover:text-white transition-colors">Contact Us</a></li>
          <li><a href="/pages/about"             class="text-blue-300 hover:text-white transition-colors">About</a></li>
          <li><a href="/pages/privacy-policy"    class="text-blue-300 hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="{{ pages['shipping-policy'].url | default: '#' }}" class="text-blue-300 hover:text-white transition-colors">Shipping Policy</a></li>
          <li><a href="{{ pages['refund-policy'].url | default: '#' }}"   class="text-blue-300 hover:text-white transition-colors">Return Policy</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t pt-8" style="border-color:rgba(255,255,255,.10)">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs" style="color:rgba(147,197,253,.5)">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>
        <p class="text-xs text-center sm:text-right max-w-xl" style="color:rgba(147,197,253,.4)">
          * These statements have not been evaluated by the Food and Drug Administration.
          This product is not intended to diagnose, treat, cure, or prevent any disease.
        </p>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "support_email",  "label": "Support email",   "default": "support@nutriglenplus.com" },
    { "type": "url",  "id": "instagram_url",  "label": "Instagram URL" },
    { "type": "url",  "id": "facebook_url",   "label": "Facebook URL" },
    { "type": "url",  "id": "tiktok_url",     "label": "TikTok URL" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
