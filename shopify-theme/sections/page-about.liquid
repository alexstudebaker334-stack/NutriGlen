<section class="min-h-screen bg-white pt-28 pb-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
      <a href="/" class="hover:text-green-700 transition-colors">Home</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      <span class="text-gray-700 font-medium">About</span>
    </nav>

    <!-- Hero -->
    <div class="text-center mb-16">
      <span class="inline-block text-green-600 font-semibold text-sm uppercase tracking-widest mb-3">Our Story</span>
      <div class="w-16 h-1 bg-green-600 rounded-full mx-auto mb-6"></div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6">About NutriGlen</h1>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto leading-relaxed">
        NutriGlen was born from a simple belief: supplements should be clean, science-backed, and actually work.
      </p>
    </div>

    <!-- Founder section -->
    <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">
      <div class="flex justify-center">
        <div class="w-56 h-56 rounded-full bg-gradient-to-br from-green-100 to-green-200 border-4 border-green-300 flex items-center justify-center shadow-xl">
          <span class="text-6xl font-extrabold text-green-700">AS</span>
        </div>
      </div>
      <div>
        <span class="inline-block text-green-600 font-semibold text-sm uppercase tracking-widest mb-3">Founder</span>
        <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Alex Studebaker</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Hi, I'm Alex — the founder of NutriGlen. I started this company after spending years frustrated by supplement brands that made big promises but delivered little results. Filled with unnecessary fillers, underdosed ingredients, and misleading labels, most products on the market simply weren't good enough.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          After researching the science behind Vitamin K2 and D3, I realized how powerful this combination truly is — and how few products were actually formulated correctly. NutriGlen K2 + D3 uses the MK-7 form of K2 and cholecalciferol D3, exactly what the research points to, at the doses that matter.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Every bottle is third-party tested, GMP certified, and made in the USA. No shortcuts. No fluff. Just real nutrition that works.
        </p>
      </div>
    </div>

    <!-- Values -->
    <div class="bg-gradient-to-br from-green-900 to-green-800 rounded-3xl p-8 lg:p-12 mb-16">
      <div class="text-center mb-10">
        <span class="text-green-400 font-semibold text-sm uppercase tracking-widest">What We Stand For</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-3">Our Values</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-center">
          <div class="w-12 h-12 rounded-full bg-green-400/20 flex items-center justify-center mx-auto mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-white font-bold mb-2">Transparency</h3>
          <p class="text-green-200 text-sm leading-relaxed">We publish every ingredient, every dose. No proprietary blends hiding underdosed ingredients.</p>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-center">
          <div class="w-12 h-12 rounded-full bg-green-400/20 flex items-center justify-center mx-auto mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2">
              <path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
            </svg>
          </div>
          <h3 class="text-white font-bold mb-2">Science-First</h3>
          <p class="text-green-200 text-sm leading-relaxed">Every formula decision is backed by peer-reviewed research, not marketing trends.</p>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-center">
          <div class="w-12 h-12 rounded-full bg-green-400/20 flex items-center justify-center mx-auto mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2">
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="text-white font-bold mb-2">Customer First</h3>
          <p class="text-green-200 text-sm leading-relaxed">30-day money-back guarantee on every order. Your satisfaction is the only metric that matters.</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-4">Ready to Feel the Difference?</h2>
      <a href="/#product" class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white font-bold px-8 py-4 rounded-full transition-all shadow-xl hover:-translate-y-1">
        Shop NutriGlen K2 + D3
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>

