<section id="benefits" class="py-24 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16">
      <span class="section-label">Why NutriGlen</span>
      <h2 class="text-4xl sm:text-5xl font-black text-white mb-4 tracking-tight">Science-Backed<br><span class="text-green-400">Benefits</span></h2>
      <p class="text-zinc-500 text-lg max-w-2xl mx-auto">
        The K2 + D3 combination is one of the most researched pairings in nutritional science.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">

      {% for block in section.blocks %}
        <div class="dark-card p-8 flex flex-col gap-6" {{ block.shopify_attributes }}>
          <div class="w-12 h-12 rounded-lg flex items-center justify-center bg-green-400/10">
            {% if forloop.index == 1 %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="1.8">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            {% elsif forloop.index == 2 %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="1.8">
                <path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
              </svg>
            {% elsif forloop.index == 3 %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="1.8">
                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            {% else %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="1.8">
                <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            {% endif %}
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">{{ block.settings.title }}</h3>
            <p class="text-zinc-500 text-sm leading-relaxed">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}

    </div>

    <!-- Stats row -->
    <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="dark-card p-6 text-center">
        <div class="text-3xl sm:text-4xl font-black text-green-400 mb-1">97%</div>
        <div class="text-zinc-500 text-sm">Reported improved energy</div>
      </div>
      <div class="dark-card p-6 text-center">
        <div class="text-3xl sm:text-4xl font-black text-green-400 mb-1">94%</div>
        <div class="text-zinc-500 text-sm">Noticed better bone wellness</div>
      </div>
      <div class="dark-card p-6 text-center">
        <div class="text-3xl sm:text-4xl font-black text-green-400 mb-1">2,400+</div>
        <div class="text-zinc-500 text-sm">5-star reviews</div>
      </div>
      <div class="dark-card p-6 text-center">
        <div class="text-3xl sm:text-4xl font-black text-white mb-1">30-Day</div>
        <div class="text-zinc-500 text-sm">Money-back guarantee</div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        { "type": "text",     "id": "title",       "label": "Title",       "default": "Heart Health" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Vitamin K2 directs calcium away from arteries and into bones, reducing arterial calcification and supporting healthy cardiovascular function." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Heart Health",    "description": "Vitamin K2 directs calcium away from arteries and into bones, reducing arterial calcification and supporting healthy cardiovascular function." } },
        { "type": "benefit", "settings": { "title": "Bone Strength",   "description": "D3 boosts calcium absorption while K2 ensures it reaches your bones. Together they deliver unmatched support for bone density and skeletal health." } },
        { "type": "benefit", "settings": { "title": "Immune Support",  "description": "Vitamin D3 is critical for activating immune defenses. Optimal D3 levels are linked to stronger immune responses and reduced inflammation." } },
        { "type": "benefit", "settings": { "title": "Energy & Mood",   "description": "Vitamin D3 receptors are present in brain tissue and play a key role in serotonin production, helping maintain energy levels and a positive mood." } }
      ]
    }
  ]
}
{% endschema %}
