<section class="hero-gradient min-h-screen flex items-center relative overflow-hidden">
  <!-- Background blobs -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-green-600/20 blur-3xl"></div>
    <div class="absolute top-1/2 -right-48 w-[500px] h-[500px] rounded-full bg-green-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 w-64 h-64 rounded-full bg-amber-500/10 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Copy -->
      <div class="text-white space-y-6 relative z-10">
        <span class="inline-flex items-center gap-2 bg-green-700/50 border border-green-500/40 text-green-200 text-xs font-semibold px-4 py-1.5 rounded-full backdrop-blur-sm">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {{ section.settings.badge_text }}
        </span>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
          {{ section.settings.heading_line1 }}
          <span class="text-green-400">{{ section.settings.heading_highlight }}</span><br>
          <span class="text-amber-400">{{ section.settings.heading_line2 }}</span>
        </h1>

        <p class="text-green-100 text-lg sm:text-xl leading-relaxed max-w-xl">
          {{ section.settings.subheading }}
        </p>

        <div class="flex flex-wrap gap-4 text-sm text-green-200">
          <span class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> Third-Party Tested</span>
          <span class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> Non-GMO</span>
          <span class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> GMP Certified</span>
          <span class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> Made in the USA</span>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a href="#product" class="inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-bold px-8 py-4 rounded-full text-lg shadow-2xl transition-all hover:-translate-y-1">
            {{ section.settings.cta_primary }}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#benefits" class="inline-flex items-center justify-center gap-2 border-2 border-green-400 text-green-300 hover:bg-green-400/10 font-semibold px-8 py-4 rounded-full text-lg transition-all">
            {{ section.settings.cta_secondary }}
          </a>
        </div>

        <div class="flex items-center gap-4 pt-2">
          <div class="flex -space-x-2">
            <div class="w-9 h-9 rounded-full border-2 border-green-800 bg-green-400 flex items-center justify-center text-xs font-bold text-white">S</div>
            <div class="w-9 h-9 rounded-full border-2 border-green-800 bg-green-500 flex items-center justify-center text-xs font-bold text-white">M</div>
            <div class="w-9 h-9 rounded-full border-2 border-green-800 bg-green-600 flex items-center justify-center text-xs font-bold text-white">J</div>
            <div class="w-9 h-9 rounded-full border-2 border-green-800 bg-green-700 flex items-center justify-center text-xs font-bold text-white">A</div>
          </div>
          <div>
            <div class="stars text-sm">★★★★★</div>
            <div class="text-green-200 text-sm"><strong class="text-white">4.9/5</strong> from 2,400+ happy customers</div>
          </div>
        </div>
      </div>

      <!-- Bottle visual -->
      <div class="flex justify-center items-center relative z-10">
        <div class="relative w-72 sm:w-80 lg:w-96">
          <div class="absolute inset-0 rounded-full bg-green-400/20 blur-2xl scale-110"></div>
          <div class="bottle-glow relative mx-auto w-64">
            <svg viewBox="0 0 200 340" xmlns="http://www.w3.org/2000/svg" class="w-full drop-shadow-2xl">
              <rect x="75" y="10" width="50" height="30" rx="6" fill="#166534"/>
              <rect x="70" y="36" width="60" height="10" rx="4" fill="#15803d"/>
              <rect x="72" y="44" width="56" height="28" rx="4" fill="#f0fdf4"/>
              <rect x="30" y="70" width="140" height="250" rx="16" fill="#f0fdf4"/>
              <rect x="36" y="80" width="128" height="234" rx="12" fill="white"/>
              <rect x="36" y="80" width="128" height="70" rx="12" fill="#16a34a"/>
              <rect x="36" y="135" width="128" height="15" fill="#16a34a"/>
              <text x="100" y="108" text-anchor="middle" fill="white" font-size="13" font-weight="bold" font-family="Arial">NutriGlen</text>
              <rect x="60" y="113" width="80" height="1.5" fill="rgba(255,255,255,0.4)"/>
              <text x="100" y="128" text-anchor="middle" fill="#bbf7d0" font-size="8" font-family="Arial" letter-spacing="2">PREMIUM SUPPLEMENTS</text>
              <text x="100" y="175" text-anchor="middle" fill="#14532d" font-size="15" font-weight="bold" font-family="Arial">VITAMIN</text>
              <text x="100" y="197" text-anchor="middle" fill="#16a34a" font-size="22" font-weight="bold" font-family="Arial">K2 + D3</text>
              <line x1="52" y1="208" x2="148" y2="208" stroke="#e5e7eb" stroke-width="1"/>
              <text x="100" y="225" text-anchor="middle" fill="#6b7280" font-size="7.5" font-family="Arial">Bone Strength &#8226; Heart Health</text>
              <text x="100" y="238" text-anchor="middle" fill="#6b7280" font-size="7.5" font-family="Arial">Immune Support</text>
              <rect x="62" y="248" width="76" height="22" rx="11" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5"/>
              <text x="100" y="263" text-anchor="middle" fill="#16a34a" font-size="9" font-weight="bold" font-family="Arial">60 CAPSULES</text>
              <text x="100" y="308" text-anchor="middle" fill="#9ca3af" font-size="6.5" font-family="Arial">Third-Party Tested &#8226; GMP Certified</text>
              <rect x="32" y="72" width="18" height="200" rx="6" fill="rgba(255,255,255,0.15)"/>
            </svg>
          </div>
          <div class="absolute -right-4 top-16 bg-white rounded-2xl shadow-xl px-4 py-3 text-center">
            <div class="text-2xl font-extrabold text-green-700">30</div>
            <div class="text-xs text-gray-500 font-medium">Day<br>Guarantee</div>
          </div>
          <div class="absolute -left-4 bottom-20 bg-white rounded-2xl shadow-xl px-4 py-3 text-center">
            <div class="text-2xl font-extrabold text-amber-600">★4.9</div>
            <div class="text-xs text-gray-500 font-medium">2,400+<br>Reviews</div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Wave -->
  <div class="absolute bottom-0 left-0 right-0 wave-divider">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0,60 C240,0 480,80 720,50 C960,20 1200,80 1440,40 L1440,80 L0,80 Z" fill="white"/>
    </svg>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "badge_text",         "label": "Badge text",           "default": "#1 Trusted Vitamin Supplement" },
    { "type": "text", "id": "heading_line1",       "label": "Heading line 1",       "default": "Fuel Your Body With" },
    { "type": "text", "id": "heading_highlight",   "label": "Heading highlight",    "default": "K2 + D3" },
    { "type": "text", "id": "heading_line2",       "label": "Heading line 2",       "default": "The Power Duo" },
    { "type": "textarea", "id": "subheading",      "label": "Subheading",           "default": "Scientifically formulated Vitamin K2 (MK-7) paired with Vitamin D3 to promote bone density, heart health, and immune strength — naturally." },
    { "type": "text", "id": "cta_primary",         "label": "Primary CTA",          "default": "Get Started Today" },
    { "type": "text", "id": "cta_secondary",       "label": "Secondary CTA",        "default": "Learn More" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
