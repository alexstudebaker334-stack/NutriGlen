<div class="min-h-screen bg-gray-50 pt-24 pb-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
      <a href="/" class="hover:text-green-700 transition-colors">Home</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      <span class="text-gray-700 font-medium">Cart</span>
    </nav>

    {%- if cart.item_count == 0 -%}

      <!-- ── Empty cart ── -->
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <div class="w-24 h-24 rounded-full bg-green-50 flex items-center justify-center mb-6">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.5">
            <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 2.3c-.6.6-.2 1.7.7 1.7H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h1 class="text-2xl font-extrabold text-gray-900 mb-2">Your cart is empty</h1>
        <p class="text-gray-500 mb-8 max-w-xs">Looks like you haven't added anything yet. Browse our products and find something you'll love.</p>
        <a href="/" class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white font-bold px-8 py-4 rounded-full transition-all shadow-lg hover:-translate-y-0.5">
          Continue Shopping
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    {%- else -%}

      <div class="flex flex-col lg:flex-row gap-10 items-start">

        <!-- ── Left: line items ── -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-extrabold text-gray-900">
              Your Cart
              <span class="text-gray-400 font-normal text-lg ml-2">({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
            </h1>
            <a href="/" class="text-sm text-green-700 hover:text-green-900 font-medium transition-colors flex items-center gap-1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Continue shopping
            </a>
          </div>

          <!-- Free shipping bar -->
          {%- assign free_threshold = settings.free_shipping_threshold | default: 50 -%}
          {%- assign threshold_cents = free_threshold | times: 100 -%}
          {%- assign remaining_cents = threshold_cents | minus: cart.total_price -%}
          <div class="bg-white rounded-2xl p-4 mb-6 border border-green-100">
            {%- if remaining_cents > 0 -%}
              {%- assign remaining_dollars = remaining_cents | money -%}
              <p class="text-sm font-medium text-green-800 mb-2">
                You're <strong>{{ remaining_dollars }}</strong> away from <strong>FREE shipping!</strong>
              </p>
            {%- else -%}
              <p class="text-sm font-semibold text-green-700 mb-2">🎉 You've unlocked FREE shipping!</p>
            {%- endif -%}
            {%- assign pct = cart.total_price | times: 100 | divided_by: threshold_cents | at_most: 100 -%}
            <div class="h-2 bg-green-100 rounded-full overflow-hidden">
              <div class="h-full bg-green-600 rounded-full transition-all" style="width: {{ pct }}%"></div>
            </div>
          </div>

          <!-- Items table -->
          <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm">
            {%- for item in cart.items -%}
              <div class="cart-line-item flex gap-5 p-5 {% unless forloop.last %}border-b border-gray-100{% endunless %}"
                   id="line-item-{{ item.key | replace: ':', '-' | replace: '/', '-' }}"
                   data-key="{{ item.key }}">

                <!-- Product image -->
                <a href="{{ item.url }}" class="flex-shrink-0">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 160 }}"
                         alt="{{ item.image.alt | escape }}"
                         class="w-24 h-24 object-cover rounded-xl border border-gray-100"
                         loading="lazy">
                  {%- else -%}
                    <div class="w-24 h-24 rounded-xl bg-green-50 flex items-center justify-center border border-green-100">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.5">
                        <path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/>
                      </svg>
                    </div>
                  {%- endif -%}
                </a>

                <!-- Details -->
                <div class="flex-1 min-w-0 flex flex-col justify-between">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <a href="{{ item.url }}" class="text-base font-bold text-gray-900 hover:text-green-700 leading-snug transition-colors">
                        {{ item.product.title }}
                      </a>
                      {%- unless item.variant.title == 'Default Title' -%}
                        <p class="text-sm text-gray-400 mt-0.5">{{ item.variant.title }}</p>
                      {%- endunless -%}
                      {%- if item.selling_plan_allocation -%}
                        <p class="text-xs text-green-700 font-medium mt-1 bg-green-50 rounded px-2 py-0.5 inline-block">
                          {{ item.selling_plan_allocation.selling_plan.name }}
                        </p>
                      {%- endif -%}
                    </div>
                    <span class="line-price text-base font-extrabold text-gray-900 flex-shrink-0" data-line-price="{{ item.final_line_price }}">
                      {{ item.final_line_price | money }}
                    </span>
                  </div>

                  <!-- Unit price -->
                  {%- if item.original_price != item.final_price -%}
                    <p class="text-xs text-gray-400 mt-0.5">
                      <s>{{ item.original_price | money }}</s>
                      <span class="text-green-600 font-medium ml-1">{{ item.final_price | money }} each</span>
                    </p>
                  {%- else -%}
                    <p class="text-xs text-gray-400 mt-0.5">{{ item.price | money }} each</p>
                  {%- endif -%}

                  <!-- Qty controls + remove -->
                  <div class="flex items-center gap-4 mt-3">
                    <div class="cart-qty-control">
                      <button class="qty-dec" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      </button>
                      <span class="item-qty" data-key="{{ item.key }}">{{ item.quantity }}</span>
                      <button class="qty-inc" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      </button>
                    </div>
                    <button class="cart-remove-btn" data-key="{{ item.key }}" aria-label="Remove item">
                      Remove
                    </button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <!-- Special instructions (optional) -->
          <div class="mt-4">
            <details class="group">
              <summary class="text-sm text-gray-500 hover:text-gray-700 cursor-pointer select-none flex items-center gap-1 transition-colors">
                <svg class="group-open:rotate-90 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                Add order note (optional)
              </summary>
              <div class="mt-3">
                <textarea name="note" form="cart-form" rows="3" placeholder="Special instructions for your order..."
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent resize-none transition-all"></textarea>
              </div>
            </details>
          </div>
        </div>

        <!-- ── Right: order summary ── -->
        <div class="w-full lg:w-[380px] flex-shrink-0">
          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden sticky top-24">

            <!-- Header -->
            <div class="bg-green-900 px-6 py-5">
              <h2 class="text-lg font-extrabold text-white">Order Summary</h2>
              <p class="text-green-300 text-sm mt-0.5">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</p>
            </div>

            <div class="px-6 py-6 space-y-4">

              <!-- Line items summary -->
              {%- for item in cart.items -%}
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600 truncate pr-3">
                    {{ item.product.title }}
                    {%- unless item.variant.title == 'Default Title' %} · {{ item.variant.title }}{%- endunless -%}
                    <span class="text-gray-400 ml-1">×{{ item.quantity }}</span>
                  </span>
                  <span class="font-semibold text-gray-900 flex-shrink-0">{{ item.final_line_price | money }}</span>
                </div>
              {%- endfor -%}

              <div class="border-t border-gray-100 pt-4 space-y-2">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600">Subtotal</span>
                  <span id="cart-page-subtotal" class="font-semibold text-gray-900">{{ cart.total_price | money }}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600">Shipping</span>
                  {%- if cart.total_price >= threshold_cents -%}
                    <span class="text-green-600 font-semibold">Free ✓</span>
                  {%- else -%}
                    <span class="text-gray-500">Calculated at checkout</span>
                  {%- endif -%}
                </div>
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <div class="flex justify-between text-sm">
                      <span class="text-green-700 font-medium">{{ discount.title }}</span>
                      <span class="text-green-700 font-semibold">-{{ discount.total_allocated_amount | money }}</span>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>

              <!-- Total -->
              <div class="border-t-2 border-gray-900 pt-4 flex justify-between items-center">
                <span class="text-base font-extrabold text-gray-900">Total</span>
                <span id="cart-page-total" class="text-2xl font-extrabold text-gray-900">{{ cart.total_price | money }}</span>
              </div>

              <!-- Discount code -->
              <form action="{{ routes.cart_url }}" method="post" id="discount-form" class="flex gap-2 pt-2">
                <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                <input type="text" name="discount" placeholder="Discount code"
                  class="flex-1 min-w-0 border border-gray-200 rounded-xl px-4 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all">
                <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors">Apply</button>
              </form>

              <!-- Checkout button -->
              <a href="/checkout" class="cart-checkout-btn-page block">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                Secure Checkout
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>

              <!-- Trust signals -->
              <div class="grid grid-cols-3 gap-3 pt-2">
                {%- assign trust = "30-Day Guarantee|Free Returns|SSL Encrypted" | split: "|" -%}
                {%- for t in trust -%}
                  <div class="flex flex-col items-center text-center gap-1.5">
                    {%- if forloop.index == 1 -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8">
                        <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                      </svg>
                    {%- elsif forloop.index == 2 -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8">
                        <path d="M3 10h10a8 8 0 018 8v2M3 10l6 6M3 10l6-6"/>
                      </svg>
                    {%- else -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8">
                        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                      </svg>
                    {%- endif -%}
                    <span class="text-xs text-gray-500 leading-tight">{{ t }}</span>
                  </div>
                {%- endfor -%}
              </div>

              <!-- Payment icons -->
              <div class="flex items-center justify-center gap-2 pt-2 opacity-50">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'h-5' }}
                {%- endfor -%}
              </div>

            </div>
          </div>
        </div>

      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [],
  "presets": [{ "name": "Cart Page" }]
}
{% endschema %}
