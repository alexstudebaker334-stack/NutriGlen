<section id="faq" class="py-24 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16">
      <span class="section-label">Got Questions?</span>
      <div class="section-divider"></div>
      <h2 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mb-4">Frequently Asked Questions</h2>
      <p class="text-gray-500 text-lg max-w-xl mx-auto">Everything you need to know about NutriGlen K2 + D3.</p>
    </div>

    <div class="space-y-3">
      {% for block in section.blocks %}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button class="faq-question w-full flex items-center justify-between text-left gap-4 px-6 py-5">
            <span class="font-semibold text-gray-900 text-base">{{ block.settings.question }}</span>
            <div class="faq-icon w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background:#f3f4f6;color:#6b7280">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </div>
          </button>
          <div class="faq-answer px-6 pb-0">
            <div class="pb-6">
              <p class="text-gray-600 leading-relaxed text-sm">{{ block.settings.answer }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 rounded-3xl p-10 text-center" style="background:#001A4D">
      <div class="text-white text-xl font-bold mb-2">Still have questions?</div>
      <p class="text-blue-200 mb-6 text-sm">Our team is available 7 days a week to help you.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:{{ section.settings.support_email }}"
           class="btn-primary px-8 py-3 text-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Email Us
        </a>
        {% if section.settings.support_phone != blank %}
        <a href="tel:{{ section.settings.support_phone }}" class="btn-secondary px-8 py-3 text-sm" style="border-color:#4b6cb7;color:#93c5fd">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {{ section.settings.support_phone }}
        </a>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "support_email", "label": "Support email", "default": "support@nutriglenplus.com" },
    { "type": "text", "id": "support_phone", "label": "Support phone (optional)", "default": "" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question", "default": "How long until I see results?" },
        { "type": "textarea", "id": "answer",   "label": "Answer",   "default": "Many customers notice improved energy and mood within 2–3 weeks. Benefits to bone density are more gradual — most customers report noticeable changes after 8–12 weeks of consistent use." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What is the difference between K1 and K2?",        "answer": "Vitamin K1 is primarily involved in blood clotting. Vitamin K2 (MK-7 form) has a much longer half-life and specifically targets bone and cardiovascular tissue — directing calcium into bones and away from arteries. NutriGlen uses the MK-7 form of K2 for maximum effectiveness." } },
        { "type": "faq_item", "settings": { "question": "Why D3 and not D2?",                               "answer": "Vitamin D3 (cholecalciferol) is the same form your body naturally produces from sunlight and is far superior at raising blood vitamin D levels compared to D2. Multiple studies show D3 is roughly 87% more potent than D2 at raising serum 25(OH)D concentrations." } },
        { "type": "faq_item", "settings": { "question": "How long until I see results?",                    "answer": "Many customers notice improved energy and mood within 2–3 weeks. Benefits to bone density and cardiovascular health are more gradual — most customers report noticeable changes after 8–12 weeks of consistent use." } },
        { "type": "faq_item", "settings": { "question": "Is it safe to take 5,000 IU of Vitamin D3?",       "answer": "5,000 IU is a clinically common dose for adults who are D-deficient. It's well within the established safe range (the tolerable upper limit is 10,000 IU/day for adults). We always recommend discussing supplementation with your healthcare provider if you have medical conditions." } },
        { "type": "faq_item", "settings": { "question": "Are there any side effects?",                      "answer": "NutriGlen K2+D3 is well-tolerated by most adults. If you are on blood-thinning medications (like warfarin), consult your doctor before taking K2, as it can affect clotting time." } },
        { "type": "faq_item", "settings": { "question": "Is NutriGlen suitable for vegans?",               "answer": "Our current formulation uses gelatin softgels, making it non-vegan. We use organic olive oil as the carrier for fat-soluble absorption. We are actively developing a vegan-certified capsule version." } },
        { "type": "faq_item", "settings": { "question": "What is your return policy?",                      "answer": "We offer a 30-day money-back guarantee. If you're not completely satisfied for any reason, contact our customer support team within 30 days of purchase and we'll issue a full refund — no questions asked." } },
        { "type": "faq_item", "settings": { "question": "How should I store my NutriGlen supplements?",    "answer": "Store in a cool, dry place away from direct sunlight. Do not refrigerate. Keep out of reach of children. Recommended storage temperature is 59–77°F (15–25°C)." } }
      ]
    }
  ]
}
{% endschema %}
