<!-- ── Cart Drawer ── -->

<!-- Overlay -->
<div id="cart-overlay" aria-hidden="true"></div>

<!-- Drawer panel -->
<div id="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping cart">

  <!-- Header -->
  <div class="cart-drawer-header">
    <div class="flex items-center gap-3">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 2.3c-.6.6-.2 1.7.7 1.7H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      <h2 class="text-lg font-bold text-gray-900">
        Your Cart
        <span id="drawer-count" class="text-gray-400 font-normal text-sm ml-1"></span>
      </h2>
    </div>
    <button id="cart-drawer-close" aria-label="Close cart" class="cart-drawer-close-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Free-shipping progress bar -->
  <div id="drawer-shipping-bar" class="cart-shipping-bar">
    <p id="drawer-shipping-text" class="cart-shipping-text"></p>
    <div class="cart-shipping-track">
      <div id="drawer-shipping-fill" class="cart-shipping-fill" style="width:0%"></div>
    </div>
  </div>

  <!-- Line items (populated by JS) -->
  <div id="drawer-items" class="cart-drawer-items"></div>

  <!-- Footer -->
  <div class="cart-drawer-footer">

    <!-- Subtotal -->
    <div class="flex items-center justify-between mb-1">
      <span class="font-semibold text-gray-800 text-base">Subtotal</span>
      <span id="drawer-subtotal" class="text-xl font-extrabold text-gray-900"></span>
    </div>
    <p class="text-xs text-gray-400 mb-4 text-center">Shipping &amp; taxes calculated at checkout</p>

    <!-- Trust row -->
    <div class="flex items-center justify-center gap-3 text-xs text-gray-500 mb-4">
      <span class="flex items-center gap-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        Secure checkout
      </span>
      <span>·</span>
      <span class="flex items-center gap-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        30-day guarantee
      </span>
    </div>

    <!-- Checkout CTA -->
    <a href="/checkout" class="cart-checkout-btn">
      Proceed to Checkout
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

    <!-- View cart link -->
    <a href="{{ routes.cart_url }}" class="cart-view-link">View full cart &rarr;</a>

  </div>
</div>

<!-- Empty cart template (cloned by JS) -->
<template id="drawer-empty-tpl">
  <div class="cart-empty-state">
    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.4">
      <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 2.3c-.6.6-.2 1.7.7 1.7H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
    </svg>
    <p class="text-gray-400 font-medium mt-3">Your cart is empty</p>
    <a href="/" class="text-green-700 hover:text-green-900 font-semibold text-sm mt-2 inline-block transition-colors">Continue Shopping &rarr;</a>
  </div>
</template>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [],
  "presets": [{ "name": "Cart Drawer" }]
}
{% endschema %}
